# CONVERGENCE-Ai — ON-PREM configuration (no external cloud services required)
# Copy to .env.onprem and edit. Everything here is optional except GATEWAY_API_KEY.

DEPLOYMENT_MODE=onprem
NODE_ENV=production
PORT=3003

# Operator API key (governance auth). REQUIRED in any shared environment.
GATEWAY_API_KEY=change-me-operator-key

# --- Governed state backend ---------------------------------------------------
# Default (single-instance on-prem): the LOCAL JSON store — leave Supabase unset.
# For MULTI-INSTANCE on-prem, run self-hosted Supabase and set these two instead:
# SUPABASE_URL=http://supabase:8000
# SUPABASE_SERVICE_ROLE_KEY=

# --- Local Postgres + pgvector (RAG / Dify) -----------------------------------
POSTGRES_PASSWORD=change-me-local
TZ=UTC

# --- Optional integrations (all optional on-prem) -----------------------------
FIRECRAWL_API_KEY=          # systems-evaluation crawl (else simulated fallback)
SERPAPI_API_KEY=            # legal Scholar + regulatory search (else simulated)
ANTHROPIC_API_KEY=          # multi-agent negotiation (claude-opus-4-8)
# Connector credentials (only for systems you connect) — env-only, never via API:
# CLIO_CLIENT_ID=  CLIO_CLIENT_SECRET=  CLIO_ACCESS_TOKEN=  CLIO_REGION=us
# GUSTO_ACCESS_TOKEN=  GUSTO_COMPANY_ID=  GUSTO_API_URL=https://api.gusto-demo.com
# REALESTATEAPI_KEY=          # MLS + property records (else simulated fallback)
# REALESTATEAPI_MCP_URL=https://mcp.realestateapi.com/sse   # optional MCP surface
